OPENAI_API_KEY=pmk_xxx
OPENAI_BASE_URL=https://your-token-gateway.example/v1

# Override only when the Gateway exposes different OpenAI-compatible paths.
# CUA_IMAGE_CREATE_PATH=/images/generations
# CUA_VIDEO_CREATE_PATH=/videos/generations

# Browser polling windows in milliseconds. Defaults: image 600000, video 1800000.
# NEXT_PUBLIC_CUA_IMAGE_POLL_DEADLINE_MS=600000
# NEXT_PUBLIC_CUA_VIDEO_POLL_DEADLINE_MS=1800000

# Keep unset for local CUA use. Remote access requires a separate trusted access layer.
# CUA_ALLOW_REMOTE=1
